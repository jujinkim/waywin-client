 #define TAG CLIENT_TAG("sdl.rail")
 
+/* WayWin stage-0 observer only. No titles, pixels, input or icon payloads.
+ * Receiving an order is NOT evidence of rendering or interaction support. */
+static bool waywinProbeEnabled()
+{
+	const char* value = std::getenv("WAYWIN_PROBE_EVENTS");
+	return value && (std::strcmp(value, "1") == 0);
+}
+
+static void waywinProbeEvent(const char* type, const WINDOW_ORDER_INFO* info)
+{
+	if (waywinProbeEnabled() && info)
+		std::fprintf(stderr, "WAYWIN_PROBE_V1 type=%s window=%" PRIu32
+		             " icon=%" PRIu32 " flags=%" PRIu32 "\n",
+		             type, (info->fieldFlags & (WINDOW_ORDER_TYPE_WINDOW | WINDOW_ORDER_TYPE_NOTIFY))
+		                 ? info->windowId : 0,
+		             (info->fieldFlags & WINDOW_ORDER_TYPE_NOTIFY) ? info->notifyIconId : 0,
+		             info->fieldFlags);
+}
+
 /* The compositor runs the drag (Wayland); the client only tracks the size. */
 [[nodiscard]] static bool compositorDrag()
 {
