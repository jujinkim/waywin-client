+		                             const NOTIFY_ICON_STATE_ORDER*) -> BOOL {
+			waywinProbeEvent("notify-create", info);
+			return TRUE;
+		};
+		window->NotifyIconUpdate = [](rdpContext*, const WINDOW_ORDER_INFO* info,
+		                             const NOTIFY_ICON_STATE_ORDER*) -> BOOL {
+			waywinProbeEvent("notify-update", info);
+			return TRUE;
+		};
+		window->NotifyIconDelete = [](rdpContext*, const WINDOW_ORDER_INFO* info) -> BOOL {
+			waywinProbeEvent("notify-delete", info);
+			return TRUE;
+		};
+	}
 }
 
