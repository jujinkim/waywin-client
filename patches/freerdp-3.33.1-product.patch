+void SdlRail::productNotify(uint32_t window, uint32_t icon, bool add)
+{
+    std::unique_lock lock(_windowsLock);
+    if (add) _notifyIcons.emplace(window, icon);
+    else { _notifyIcons.erase({window, icon}); _notifyVersions.erase({window,icon}); }
+}
+
+void SdlRail::productCommand(unsigned action, uint32_t window, uint32_t icon)
+{
+    std::unique_lock lock(_windowsLock);
+    if (!_rail || !std::getenv("WAYWIN_PRODUCT")) return;
+    if (action >= 5) {
+        if (!_notifyIcons.count({window, icon}) || !_rail->ClientNotifyEvent) return;
+        RAIL_NOTIFY_EVENT_ORDER event{};
+        event.windowId = window; event.notifyIconId = icon;
+        const bool modern = _notifyVersions[{window,icon}] >= 3;
+        event.message = action == 5 ? (modern ? NIN_SELECT : WM_LBUTTONUP) : (modern ? WM_CONTEXTMENU : WM_RBUTTONUP);
+        std::ignore = _rail->ClientNotifyEvent(_rail, &event);
+        return;
+    }
+    auto target = getWindow(window);
+    if (!target || !target->window()) return;
+    if (action == 1) {
+        sendSystemCommand(target, SC_RESTORE);
+        sendClientActivate(window, true);
+        SDL_RaiseWindow(target->window());
+    } else if (action == 2) sendSystemCommand(target, SC_MINIMIZE);
+    else if (action == 3) sendSystemCommand(target, SC_RESTORE);
+    else if (action == 4) sendSystemCommand(target, SC_CLOSE);
+}
+
+void SdlRail::productTick()
+{
+    std::unique_lock lock(_windowsLock);
+    if (waywinRecovering || _productPending.empty()) return;
+    if (!_productRetireAt) _productRetireAt=SDL_GetTicks()+3000;
+    if (SDL_GetTicks()<_productRetireAt) return;
+    for (auto id:_productPending) {
+        auto target=getWindow(id);
+        if(target) target->markDeleted();
+        WINDOW_ORDER_INFO info{};info.windowId=id;waywinProbeEvent("window-delete",&info);
+    }
+    _productPending.clear();_productRetireAt=0;
+}
+void SdlRail::productNotifyData(const WINDOW_ORDER_INFO*info,const NOTIFY_ICON_STATE_ORDER*state)
+{
+    if(!std::getenv("WAYWIN_PRODUCT"))return;
+    std::unique_lock lock(_windowsLock);
+    if(info->fieldFlags&WINDOW_ORDER_FIELD_NOTIFY_VERSION)_notifyVersions[{info->windowId,info->notifyIconId}]=state->version;
+    if(info->fieldFlags&WINDOW_ORDER_FIELD_NOTIFY_TIP) {
+        char*text=rail_string_to_utf8_string(&state->toolTip);
+        if(text) {
+            WayWinWire::Message m{WayWinWire::TrayTitle,info->windowId,0,{}};
+            WayWinWire::put(m.data,info->notifyIconId);WayWinWire::string(m.data,std::string(text).substr(0,4096));waywinEmit(std::move(m));free(text);
+        }
+    }
+    SdlRailIcon decoded;SdlRailIcon*icon=nullptr;
+    if(info->fieldFlags&WINDOW_ORDER_ICON) {
+        if(state->icon.width>256||state->icon.height>256||!convertRailIcon(&state->icon,decoded))return;
+        icon=iconCacheLookup(state->icon.cacheId,state->icon.cacheEntry);
+        if(icon)*icon=decoded;else icon=&decoded;
+    } else if(info->fieldFlags&WINDOW_ORDER_CACHED_ICON)icon=iconCacheLookup(state->cachedIcon.cacheId,state->cachedIcon.cacheEntry);
+    if(!icon||icon->bgra.empty()||icon->w>256||icon->h>256)return;
+    WayWinWire::Message m{WayWinWire::Icon,info->windowId,0,{}};
+    WayWinWire::put(m.data,info->notifyIconId);WayWinWire::put(m.data,icon->w);WayWinWire::put(m.data,icon->h);
+    m.data.insert(m.data.end(),icon->bgra.begin(),icon->bgra.end());waywinEmit(std::move(m));
+}
