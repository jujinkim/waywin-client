--- /dev/null
+++ b/client/SDL/SDL3/waywin_product.hpp
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <SDL3/SDL.h>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+#include <atomic>
+#include <unistd.h>
+struct WayWinCommand { unsigned action, window, icon; };
+inline std::atomic<Uint32> waywinEvent = 0;
+inline void waywinStartCommands() {
+    if (!std::getenv("WAYWIN_PRODUCT") || waywinEvent) return;
+    waywinEvent = SDL_RegisterEvents(1);
+    std::thread([] {
+        char line[128] = {}; size_t size = 0; bool drop = false; char c = 0;
+        while (::read(STDIN_FILENO, &c, 1) == 1) {
+            if (c == '\n') {
+                line[size] = 0;
+                auto cmd = new WayWinCommand{}; char tail = 0;
+                const bool valid = !drop && std::sscanf(line, "%u %u %u %c", &cmd->action, &cmd->window, &cmd->icon, &tail) == 3 && cmd->action >= 1 && cmd->action <= 6;
+                if (valid) {
+                    SDL_Event event{}; event.type = waywinEvent; event.user.data1 = cmd;
+                    if (!SDL_PushEvent(&event)) delete cmd;
+                } else delete cmd;
+                size = 0; drop = false;
+            } else if (size < sizeof(line)-1) line[size++] = c;
+            else drop = true;
+        }
+    }).detach();
+}
