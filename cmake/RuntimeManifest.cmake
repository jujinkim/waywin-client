file(READ "${BUILD}/compile_commands.json" compile_commands)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND NOT compile_commands MATCHES "WITH_SDL_WAYLAND_NATIVE")
  message(FATAL_ERROR "Native Wayland support missing; install the Wayland development packages")
endif()
file(SHA256 "${ROOT}/patches/freerdp-3.33.1-product.patch" product_hash)
file(SHA256 "${ROOT}/patches/freerdp-3.33.1-probe.patch" probe_hash)
file(GLOB_RECURSE files RELATIVE "${STAGE}" "${STAGE}/bin/*" "${STAGE}/lib/*")
set(json "{\"schema\":\"waywin-runtime-1\",\"source_commit\":\"65bcca1913a28cbdd7eb913599f692bd2b707991\",\"product_patch_sha256\":\"${product_hash}\",\"probe_patch_sha256\":\"${probe_hash}\",\"binary\":\"bin/sdl3-freerdp\",\"system\":\"${CMAKE_HOST_SYSTEM_NAME}\",\"files\":{")
set(comma "")
foreach(path IN LISTS files)
  if(NOT IS_DIRECTORY "${STAGE}/${path}")
    file(SHA256 "${STAGE}/${path}" hash)
    string(APPEND json "${comma}\"${path}\":\"${hash}\"")
    set(comma ",")
  endif()
endforeach()
string(APPEND json "}}\n")
file(WRITE "${STAGE}/waywin-runtime.json" "${json}")
