# Product runtime profile. Software graphics and explicit companion clipboard; no file/device sharing.
set(CMAKE_BUILD_TYPE Release CACHE STRING "" FORCE)
# Bundled sources have no Git metadata. Keep their release version and prohibit
# optional FetchContent dependencies from downloading during the product build.
set(USE_VERSION_FROM_GIT_TAG OFF CACHE BOOL "" FORCE)
set(USE_GIT_FOR_REVISION OFF CACHE BOOL "" FORCE)
set(FETCHCONTENT_FULLY_DISCONNECTED ON CACHE BOOL "" FORCE)
set(WITH_CWALK OFF CACHE BOOL "" FORCE)
set(WITH_WEBVIEW_AAD_AUTH_HELPER OFF CACHE BOOL "" FORCE)
set(WITH_CLIENT ON CACHE BOOL "" FORCE)
set(WITH_CLIENT_SDL ON CACHE BOOL "" FORCE)
set(WITH_CLIENT_SDL3 ON CACHE BOOL "" FORCE)
set(WITH_CLIENT_SDL2 OFF CACHE BOOL "" FORCE)
set(WITH_CLIENT_SDL_VERSIONED ON CACHE BOOL "" FORCE)
set(WITH_SERVER OFF CACHE BOOL "" FORCE)
set(WITH_SAMPLE OFF CACHE BOOL "" FORCE)
# Disable the separate xfreerdp client; SDL3 still builds its native X11 helpers.
set(WITH_X11 OFF CACHE BOOL "" FORCE)
# This disables the separate legacy Wayland client, NOT SDL3's native helpers.
set(WITH_WAYLAND OFF CACHE BOOL "" FORCE)
set(WITH_MANPAGES OFF CACHE BOOL "" FORCE)
set(BUILD_TESTING OFF CACHE BOOL "" FORCE)
set(WITH_FFMPEG OFF CACHE BOOL "" FORCE)
set(WITH_OPENH264 OFF CACHE BOOL "" FORCE)
set(WITH_SWSCALE OFF CACHE BOOL "" FORCE)
set(WITH_KRB5 OFF CACHE BOOL "" FORCE)
set(WITH_PKCS11 OFF CACHE BOOL "" FORCE)
set(WITH_PCSC OFF CACHE BOOL "" FORCE)
set(WITH_CUPS OFF CACHE BOOL "" FORCE)
# Clipboard transfer is explicit text over the product DVC; filesystem clipboard is disabled.
set(WITH_FUSE OFF CACHE BOOL "" FORCE)
set(CHANNEL_URBDRC OFF CACHE BOOL "" FORCE)
set(CHANNEL_DRIVE OFF CACHE BOOL "" FORCE)
set(CHANNEL_PRINTER OFF CACHE BOOL "" FORCE)
set(CHANNEL_SMARTCARD OFF CACHE BOOL "" FORCE)
set(CHANNEL_AUDIN OFF CACHE BOOL "" FORCE)
set(CHANNEL_RDPECAM OFF CACHE BOOL "" FORCE)
set(CHANNEL_RDPDR OFF CACHE BOOL "" FORCE)
set(WITH_DEBUG_ALL OFF CACHE BOOL "" FORCE)
set(WITH_DEBUG_SDL_KBD_EVENTS OFF CACHE BOOL "" FORCE)
set(WITH_DEBUG_KBD OFF CACHE BOOL "" FORCE)
set(WITH_DEBUG_NLA OFF CACHE BOOL "" FORCE)
